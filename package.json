{
  "name": "htwr-gobbler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wrangler dev --ip 127.0.0.1\"",
    "start": "concurrently -k \"tsx scripts/local-server.ts\" \"wrangler dev --ip 127.0.0.1 --port 8787\"",
    "local": "tsx scripts/local.ts",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "wrangler d1 migrations apply gobbler --local",
    "deploy": "pnpm build && wrangler deploy",
    "mcp": "tsx apps/mcp/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "hono": "^4.12.0",
    "ical.js": "^2.2.1",
    "jose": "^6.1.3",
    "lucide-react": "^0.577.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.69.0"
  }
}
